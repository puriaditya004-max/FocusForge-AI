# Copy this file to keystore.properties (same folder) and fill in
# your real values. keystore.properties itself is gitignored — it
# must NEVER be committed, because it (along with the .jks/.keystore
# file it points at) is the one secret that has to survive for the
# entire lifetime of the app on Play Store. Losing it means you can
# never publish an update to the same app listing again; leaking it
# means anyone with it can sign a malicious update as if it were you.
#
# See ../docs/ANDROID_RELEASE.md for how to generate the keystore
# this file points to.

storeFile=../focusforge-release.jks
storePassword=CHANGE_ME
keyAlias=focusforge
keyPassword=CHANGE_ME
