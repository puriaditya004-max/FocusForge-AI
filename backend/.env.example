# Use Neon's POOLED connection string here, not the direct one.
# In the Neon console: Dashboard -> Connection Details -> toggle
# "Pooled connection". The pooled host has "-pooler" in it, e.g.
# ep-xxxx-pooler.ap-southeast-1.aws.neon.tech — that's Neon's
# built-in PgBouncer-equivalent (connection pooling as a managed
# feature, no separate PgBouncer service to run/maintain). Without
# it, each concurrent request opens its own Postgres connection and
# Neon's free/low tiers have a low connection cap — real traffic
# will start throwing "too many connections" errors long before the
# app itself is under meaningful load.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@your-neon-host-pooler/neondb?sslmode=require&channel_binding=require"
# Redis — shares rate-limit counters and Socket.IO (Study Room chat)
# broadcasts across backend instances. Leave unset for local dev or
# a single Render instance (everything falls back to in-memory
# automatically); set this before scaling to 2+ instances. Any
# managed Redis works — Upstash and Render's own Key Value both have
# a free/cheap tier that's plenty for this app's traffic.
REDIS_URL=""
# Object storage (Cloudflare R2 recommended — free tier never expires
# and R2 never charges for egress/bandwidth, unlike AWS S3's 12-month
# free trial + always-billed egress. This matters a lot for an app
# that serves lecture videos.
#
# Setup (Cloudflare dashboard -> R2):
#   1. Create a bucket, e.g. "focusforge-uploads"
#   2. R2 -> Manage API Tokens -> create a token with Object Read &
#      Write permissions on that bucket -> copy Access Key ID + Secret
#   3. S3_ENDPOINT is your account's R2 endpoint:
#      https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   4. To serve files publicly: R2 bucket -> Settings -> enable the
#      public r2.dev URL (or connect a custom domain), then set
#      PUBLIC_BASE_URL to that.
#
# Leave S3_BUCKET unset for local dev — uploads fall back to local
# disk automatically, exactly as before this was added.
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
PUBLIC_BASE_URL=""
# Sentry — error tracking. Free tier (5k errors/month) is plenty for
# a solo-founder launch. Get a DSN at sentry.io -> new Node.js project.
# Leave unset to skip Sentry entirely; errors still go to the winston
# console/file logs either way.
SENTRY_DSN=""
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY=""
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"
# In production: ADMIN_URL="https://admin.focusforge.app" (or wherever
# the standalone admin-app/ project gets deployed)
# AI
GEMINI_API_KEY=""
MENTOR_KEY_ENCRYPTION_SECRET=""
# Budget alert: how many Gemini calls per day (across ALL students
# combined, on the shared free-tier key) before FocusForge logs a
# loud warning (forwarded to Sentry when SENTRY_DSN is set). Google's
# published free-tier daily-request numbers change often and
# disagree across sources — check your actual current quota at
# ai.google.dev (AI Studio console) and set this to roughly 80% of
# that real number, not a number copied from a blog post.
GEMINI_DAILY_ALERT_THRESHOLD="400"
# Razorpay Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# OTP delivery — mobile
OTP_SMS_PROVIDER=""
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SMS_OTP_WEBHOOK_URL=""
# OTP delivery — email
OTP_EMAIL_PROVIDER="msg91"
MSG91_EMAIL_TEMPLATE_ID="global_otp"
MSG91_EMAIL_FROM="otp@mail.focusforgeai.in"
MSG91_EMAIL_DOMAIN="mail.focusforgeai.in"
